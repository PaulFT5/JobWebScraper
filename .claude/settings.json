{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_fe_only.py\"",
            "timeout": 15,
            "onFailure": "block",
            "statusMessage": "Checking FE-only edit rule"
          }
        ]
      }
    ]
  }
}
